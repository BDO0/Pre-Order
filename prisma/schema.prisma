// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  VIEWER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum PreorderStatus {
  OPEN
  COMING_SOON
  CLOSED
  SOLD_OUT
  DISABLED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  REFUNDED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

// ─────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// CAMPAIGN
// ─────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  coverImage  String?
  status      CampaignStatus @default(DRAFT)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products CampaignProduct[]
  orders   Order[]

  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("PHP")
  images          String[]
  category        String?
  active          Boolean        @default(true)
  preorderEnabled Boolean        @default(false)
  preorderStatus  PreorderStatus @default(DISABLED)
  preorderStartAt DateTime?
  preorderEndAt   DateTime?
  preorderLimit   Int?
  preorderReserved Int           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variants  ProductVariant[]
  campaigns CampaignProduct[]

  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  size              String?
  color             String?
  sku               String?
  priceOverride     Decimal? @db.Decimal(10, 2)
  capacity          Int?
  remainingCapacity Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────
// CAMPAIGN <-> PRODUCT JOIN
// ─────────────────────────────────────────────────────────────

model CampaignProduct {
  campaignId String
  productId  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@id([campaignId, productId])
  @@map("campaign_products")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMER (guest — no account required)
// ─────────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(cuid())
  fullName        String
  mobileNumber    String
  email           String?
  instagramHandle String?
  messengerName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@index([mobileNumber])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────
// PAYMENT METHOD
// ─────────────────────────────────────────────────────────────

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  instructions  String?
  accountName   String?
  accountNumber String?
  qrImage       String?
  requiresProof Boolean  @default(true)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("payment_methods")
}

// ─────────────────────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────────────────────

model Order {
  id              String          @id @default(cuid())
  reference       String          @unique // PO-20260826-0001
  campaignId      String
  customerId      String?
  paymentMethodId String
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  fulfillmentType FulfillmentType @default(DELIVERY)

  // Idempotency
  idempotencyKey String? @unique

  // Pricing — server-calculated, immutable after creation
  subtotal       Decimal @db.Decimal(10, 2)
  shippingAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  // Snapshots — historical integrity, never rely on current product data
  customerSnapshot Json // { fullName, mobileNumber, email, ... }
  deliverySnapshot Json // { type, address, city, ... }

  // Duplicate detection
  isPossibleDuplicate Boolean @default(false)
  duplicateOfRef      String?

  // Admin
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign             @relation(fields: [campaignId], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id])
  paymentMethod  PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  items          OrderItem[]
  proofs         PaymentProof[]
  statusHistory  OrderStatusHistory[]
  auditLogs      AuditLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([campaignId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int

  // Snapshots — price/name never affected by future product edits
  unitPriceAtPurchase Decimal @db.Decimal(10, 2)
  productNameSnapshot String
  variantSnapshot     Json    // { size, color, sku }

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// PAYMENT PROOF
// ─────────────────────────────────────────────────────────────

model PaymentProof {
  id         String   @id @default(cuid())
  orderId    String
  fileKey    String   // Storage key — NOT the raw URL
  mimeType   String
  uploadedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("payment_proofs")
}

// ─────────────────────────────────────────────────────────────
// ORDER STATUS HISTORY (state machine audit trail)
// ─────────────────────────────────────────────────────────────

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?     // admin email or "system"
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  actor     String   // admin email or "customer" or "system"
  action    String   // e.g. "order.created", "payment.verified"
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// ORDER REFERENCE COUNTER
// ─────────────────────────────────────────────────────────────

// Per-day counter behind generateOrderReference(). One row per day, advanced by
// a single atomic upsert so concurrent checkouts cannot receive the same order
// reference. Declared here to keep the schema in step with the database; the
// allocation itself uses raw SQL because Prisma's upsert is not atomic against
// a concurrent insert.
model OrderCounter {
  day       DateTime @id @db.Date
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("order_counters")
}

// ─────────────────────────────────────────────────────────────
// SETTINGS (operator-editable configuration)
// ─────────────────────────────────────────────────────────────

// Key/value store for values the shop owner can change without a deploy.
//
// JSONB rather than one column per setting: adding a knob is a seed/UI change
// instead of a migration. The key registry and defaults live in
// src/lib/pricing.ts (SETTING_KEYS / normaliseShippingFee), which is also what
// keeps a hand-edited row from ever producing a NaN total.
//
// Currently holds `pricing.shipping_fee`, replacing the flat `150` that used to
// be hardcoded in the order service, the cart and the checkout summary.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("settings")
}

