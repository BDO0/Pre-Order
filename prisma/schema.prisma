


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}





enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  VIEWER
}

enum BatchStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum PreorderStatus {
  OPEN
  COMING_SOON
  CLOSED
  SOLD_OUT
  DISABLED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
}





enum PaymentStatus {
  UNPAID
  PAID
}


enum FormFieldType {
  TEXT
  TEXTAREA
  PHONE
  EMAIL
  NUMBER
  SELECT
}





model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}





model Batch {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  coverImage  String?
  status      BatchStatus    @default(DRAFT)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products BatchProduct[]
  orders   Order[]

  @@map("batches")
}





model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("PHP")
  images          String[]
  category        String?
  active          Boolean        @default(true)
  preorderEnabled Boolean        @default(false)
  preorderStatus  PreorderStatus @default(DISABLED)
  preorderStartAt DateTime?
  preorderEndAt   DateTime?
  preorderLimit   Int?
  preorderReserved Int           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variants  ProductVariant[]
  batches   BatchProduct[]

  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  size              String?
  color             String?
  sku               String?
  priceOverride     Decimal? @db.Decimal(10, 2)
  capacity          Int?
  remainingCapacity Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@map("product_variants")
}





model BatchProduct {
  batchId   String
  productId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([batchId, productId])
  @@map("batch_products")
}





model Customer {
  id              String   @id @default(cuid())
  fullName        String
  
  
  
  
  instagramHandle String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@map("customers")
}







model Order {
  id         String        @id @default(cuid())
  reference  String        @unique 
  batchId    String
  customerId String?
  status     OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  
  idempotencyKey String? @unique

  
  
  
  
  
  
  
  
  
  
  accessToken String? @unique

  
  subtotal       Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  
  
  customerSnapshot Json

  
  isPossibleDuplicate Boolean @default(false)
  duplicateOfRef      String?

  
  
  
  isNewCustomer Boolean @default(true)

  
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch         Batch                @relation(fields: [batchId], references: [id])
  customer      Customer?            @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([batchId])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int

  
  unitPriceAtPurchase Decimal @db.Decimal(10, 2)
  productNameSnapshot String
  variantSnapshot     Json    

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}





model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?     
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}





model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  actor     String   
  action    String   
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}










model OrderCounter {
  day       DateTime @id @db.Date
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("order_counters")
}





model OrderFormField {
  id          String        @id @default(cuid())
  key         String        @unique
  label       String
  type        FormFieldType @default(TEXT)
  placeholder String?
  helpText    String?
  required    Boolean       @default(false)
  sensitive   Boolean       @default(false)
  
  
  
  
  
  options     String[]      @default([])
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  
  
  
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([active, sortOrder])
  @@map("order_form_fields")
}



