// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  PRODUCT_MANAGER
  VIEWER
}

enum BatchStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ARCHIVED
}

enum PreorderStatus {
  OPEN
  COMING_SOON
  CLOSED
  SOLD_OUT
  DISABLED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
  REJECTED
}

// Money is either received or it is not, and the operator is the only one who
// knows. This is a manual toggle, not a review workflow: there is no proof to
// approve and no customer-facing payment step, so PENDING_REVIEW/REFUNDED would
// be states nothing could ever reach.
enum PaymentStatus {
  UNPAID
  PAID
}

// Input type for an operator-defined pre-order form field.
enum FormFieldType {
  TEXT
  TEXTAREA
  PHONE
  EMAIL
  NUMBER
  SELECT
}

// ─────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// BATCH
// ─────────────────────────────────────────────────────────────

model Batch {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  coverImage  String?
  status      BatchStatus    @default(DRAFT)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products BatchProduct[]
  orders   Order[]

  @@map("batches")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────────────────────

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String?
  price           Decimal        @db.Decimal(10, 2)
  currency        String         @default("PHP")
  images          String[]
  category        String?
  active          Boolean        @default(true)
  preorderEnabled Boolean        @default(false)
  preorderStatus  PreorderStatus @default(DISABLED)
  preorderStartAt DateTime?
  preorderEndAt   DateTime?
  preorderLimit   Int?
  preorderReserved Int           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  variants  ProductVariant[]
  batches   BatchProduct[]

  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  size              String?
  color             String?
  sku               String?
  priceOverride     Decimal? @db.Decimal(10, 2)
  capacity          Int?
  remainingCapacity Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────
// BATCH <-> PRODUCT JOIN
// ─────────────────────────────────────────────────────────────

model BatchProduct {
  batchId   String
  productId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([batchId, productId])
  @@map("batch_products")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMER (guest — no account required)
// ─────────────────────────────────────────────────────────────

model Customer {
  id              String   @id @default(cuid())
  fullName        String
  // The Instagram account is the identity: it is how every order, payment and
  // shipping detail is settled, and it is what makes two "Juan dela Cruz" rows
  // distinguishable. Stored normalised (lowercase, no leading "@") so that
  // "@JuanDC" and "juandc" are one customer. "@" is not part of a handle.
  instagramHandle String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@map("customers")
}



// ─────────────────────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────────────────────

model Order {
  id         String        @id @default(cuid())
  reference  String        @unique // PO-20260826-0001
  batchId    String
  customerId String?
  status     OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Idempotency
  idempotencyKey String? @unique

  // The customer's private handle on their own order.
  //
  // A 192-bit random token, minted when the order is created and handed to the
  // customer once, on the confirmation screen. It is the *convenience* route
  // back to an order; the lookup form (reference + Instagram handle) is the
  // fallback, so an order without a token is still trackable.
  //
  // Nullable on purpose: orders placed before the token existed have none, and
  // making the column NOT NULL would mean inventing a value for them. NULL is
  // the truthful answer, and the lookup form covers them.
  accessToken String? @unique

  // Pricing — server-calculated, immutable after creation
  subtotal       Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  // Snapshot — historical integrity, never rely on current product data.
  // { fullName, instagramHandle, answers: [{ key, label, value }] }
  customerSnapshot Json

  // Duplicate detection
  isPossibleDuplicate Boolean @default(false)
  duplicateOfRef      String?

  // Was this the customer's first ever order, as decided when it was placed?
  // Recorded rather than derived: "new customer" is a fact about the moment the
  // order arrived, and the dashboard needs it long after a second order exists.
  isNewCustomer Boolean @default(true)

  // Admin
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch         Batch                @relation(fields: [batchId], references: [id])
  customer      Customer?            @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([batchId])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int

  // Snapshots — price/name never affected by future product edits
  unitPriceAtPurchase Decimal @db.Decimal(10, 2)
  productNameSnapshot String
  variantSnapshot     Json    // { size, color, sku }

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// ORDER STATUS HISTORY (state machine audit trail)
// ─────────────────────────────────────────────────────────────

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?     // admin email or "system"
  note       String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  actor     String   // admin email or "customer" or "system"
  action    String   // e.g. "order.created", "payment.verified"
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// ORDER REFERENCE COUNTER
// ─────────────────────────────────────────────────────────────

// Per-day counter behind generateOrderReference(). One row per day, advanced by
// a single atomic upsert so concurrent checkouts cannot receive the same order
// reference. Declared here to keep the schema in step with the database; the
// allocation itself uses raw SQL because Prisma's upsert is not atomic against
// a concurrent insert.
model OrderCounter {
  day       DateTime @id @db.Date
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("order_counters")
}

// ─────────────────────────────────────────────────────────────
// PRE-ORDER FORM FIELDS
// ─────────────────────────────────────────────────────────────

model OrderFormField {
  id          String        @id @default(cuid())
  key         String        @unique
  label       String
  type        FormFieldType @default(TEXT)
  placeholder String?
  helpText    String?
  required    Boolean       @default(false)
  sensitive   Boolean       @default(false)
  // Declared as a default because the database already has one: this column was
  // pushed from an earlier revision of the schema with `DEFAULT ARRAY[]::TEXT[]`,
  // and a schema that omits it makes `prisma migrate diff` want to DROP DEFAULT
  // on a live database — a change with no benefit and a real chance of upsetting
  // an insert that omits the column. The model now says what the database does.
  options     String[]      @default([])
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  // `@default(now())` for the same reason: the column carries
  // `DEFAULT CURRENT_TIMESTAMP` in the database, and this is how the other
  // models in this file (OrderCounter) already express both facts.
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([active, sortOrder])
  @@map("order_form_fields")
}



