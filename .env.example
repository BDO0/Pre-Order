# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL="postgresql://user:password@localhost:5432/preorder_system"

# --- Deploying to a serverless host (Vercel) against Supabase ----------------
# Use the Supavisor POOLER host, not the direct one. Every serverless instance
# opens its own connections and the direct host allows only a few dozen, so the
# app starts failing with "too many clients" under normal traffic. Port 6543 is
# the transaction pooler, which is what a request/response app wants:
#
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
#
# Set PGPOOL_MAX=1 there as well, so each instance holds a single socket and
# Supavisor does the multiplexing.
#
# Migrations must NOT run through the transaction pooler. Keep the direct
# connection string available for `prisma migrate deploy`:
#
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres"
#
# Supabase's free tier pauses a project after ~7 idle days. A scheduled request
# to /api/health (Vercel Cron, UptimeRobot, or the GitHub Action described in
# docs/DEPLOYMENT.md) keeps it awake; the paid tier or a keep-alive ping is the
# only real fix.

# Sockets per instance. Leave unset locally (default 10); set to 1 in serverless.
# PGPOOL_MAX="1"

# Integration tests (tests/order-concurrency.test.ts) only activate when this is
# set; without it they are reported as skipped. They delete the rows they
# create, so point it at a throwaway database (a Supabase branch, or a local
# Postgres) and NEVER at one holding real orders. Leave it blank to skip them.
TEST_DATABASE_URL=""

# ─────────────────────────────────────────────────────────────
# NEXT AUTH
# ─────────────────────────────────────────────────────────────
# Signs the session JWT. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Auth.js v5 trusts the request Host header based on AUTH_URL, AUTH_TRUST_HOST,
# VERCEL, CF_PAGES or NODE_ENV !== "production". NEXTAUTH_URL is NOT consulted
# for that decision, so a production build on a non-Vercel host must set one of
# these or every /api/auth/* request fails with "UntrustedHost" (HTTP 500).
# AUTH_URL is preferred: it also pins the redirect target.
AUTH_URL="http://localhost:3000"
# Only needed when AUTH_URL cannot be set (e.g. multiple domains):
# AUTH_TRUST_HOST="true"

# Kept for compatibility with tooling that expects the v4 name.
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────────────────────
# WHERE PRODUCT AND BATCH IMAGERY GOES.
#
# "local" writes into public/uploads and is served statically. It is the default
# and it needs no account anywhere — but it requires a filesystem that can be
# written to, which a serverless host does NOT have. On Vercel, an upload with
# the local driver fails with a 503 and an explanatory message.
#
# "supabase" uploads to Supabase Storage over its HTTP API (no extra dependency).
# Leave STORAGE_PROVIDER blank to pick it automatically as soon as SUPABASE_URL
# and SUPABASE_SERVICE_KEY are set, or set it explicitly.
STORAGE_PROVIDER=""
# Only used by the local driver. Blank means ./public/uploads, which is where the
# /uploads/<file> URL this API returns is served from. A custom directory works
# only if the host serves it at /uploads/, otherwise the upload succeeds and the
# image 404s.
LOCAL_UPLOAD_DIR=""

# Service-role key: SERVER-ONLY. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
# Buckets must exist and be PUBLIC (storefront imagery is served by URL).
STORAGE_BUCKET_PRODUCTS="products"
STORAGE_BUCKET_BATCHES="batches"

# ─────────────────────────────────────────────────────────────
# EMAIL (optional)
# ─────────────────────────────────────────────────────────────
# Not used. The app deliberately sends no notifications: there is no email, no
# SMS and no push, because the operator works one queue in the admin panel and
# the dashboard's action list is what surfaces an order that needs attention.
# See "Why there are no notifications" in the README before wiring any of these.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourdomain.com"

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
# Used to build absolute URLs for metadata, the Open Graph cards, robots.txt and
# the sitemap. On Vercel the deployment hostname is used automatically when this
# is unset; set it to the real domain so shared links unfurl correctly.
APP_URL="http://localhost:3000"

# Shown to customers ("Message us @handle") and on the social card. The "@" is
# optional. This is the single most important piece of trust copy on the site.
NEXT_PUBLIC_INSTAGRAM_HANDLE="ana.clothing"

NODE_ENV="development"
