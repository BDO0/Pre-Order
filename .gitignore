# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template documents every variable the app reads, so it must ship with the
# repo. Only the real .env (which holds live secrets) stays ignored.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded files — contains customer PII (payment proofs, product images).
# NEVER commit these: they are user data, not source.
/public/uploads

# The repo-root uploads/ directory is what a custom LOCAL_UPLOAD_DIR produces.
# It is double trouble: those files are not served (/uploads/<file> is served
# from public/uploads), and the directory is not source.
/uploads

# Payment proofs live OUTSIDE public/ on purpose: they are screenshots of a
# customer's banking app (names, account numbers, sometimes GPS metadata). They
# are only readable through /api/admin/proofs, which checks the session first.
/private

# Purge backups (npm run demo:purge): whole rows, including customer names and
# Instagram handles. Evidence that lives on one machine, never source.
/.purge-backups

# local tooling scratch
/_tmp
/.cline-*
